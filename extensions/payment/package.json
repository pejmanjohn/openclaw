{
  "name": "@pejmanjohn/openclaw-payment",
  "version": "1.0.0",
  "description": "Agent-driven payments for OpenClaw via Stripe Link virtual cards (browser-fill with sentinel substitution) and HTTP 402 / Machine Payments Protocol (MPP)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pejmanjohn/openclaw"
  },
  "type": "module",
  "scripts": {
    "plugin:check": "pnpm dlx @openclaw/plugin-inspector@0.3.5 inspect --no-openclaw",
    "plugin:ci": "pnpm dlx @openclaw/plugin-inspector@0.3.5 ci --no-openclaw --runtime --mock-sdk --allow-execute"
  },
  "dependencies": {
    "typebox": "1.1.34",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@pejmanjohn/openclaw-payment",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.3"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "openclawVersion": "2026.5.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
